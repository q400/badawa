										<tr>
											<td height="36" bgcolor="#FFFFFF" style="padding-left:10px;" class="fc2 f14 fb" ><a id="rule03_c" name="rule03_c">▣ 학생 선도 규정</a></td>
											<td bgcolor="#FFFFFF"></td>
